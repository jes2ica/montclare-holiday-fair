{
  // Montclare Holiday Fair, a Cloudflare Pages project in the Montclare PA's Cloudflare
  // account, served at holidayfair.montclarepa.org (a CNAME at GoDaddy points here).
  // The API lives in public/_worker.js (Pages advanced mode).
  "name": "montclare-holiday-fair",
  "pages_build_output_dir": "./public",
  "compatibility_date": "2025-09-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "montclare-holiday-fair",
      "database_id": "REPLACE_WITH_ID_FROM_wrangler_d1_create"
    }
  ],
  "vars": {
    // Number of face painters working at the same time, and minutes per child.
    "PAINTERS": "1",
    "MINUTES_PER_CHILD": "10",
    // 50/50 raffle ticket bundles as "qty:dollars". Buyers pay at the table by Square or cash.
    "RAFFLE_PRICES": "1:5,5:20,15:50",
    // Square Point of Sale API (developer.squareup.com app). The callback must match the
    // Web callback URL saved in that app's Point of Sale API settings exactly.
    "SQUARE_APP_ID": "sq0idp-oYAdQWFctX5lElyN68PKgw",
    "SQUARE_CALLBACK_URL": "https://holidayfair.montclarepa.org/raffle/staff/"
  }
  // Secrets (set with `npx wrangler pages secret put NAME`, never written here):
  //   STAFF_PIN                      required for both staff consoles
  //   TWILIO_ACCOUNT_SID             optional, enables "turn ready" texts
  //   TWILIO_AUTH_TOKEN              optional
  //   TWILIO_MESSAGING_SERVICE_SID   optional (or TWILIO_FROM, a +1 number)
}
